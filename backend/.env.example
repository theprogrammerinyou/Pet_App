# MongoDB connection – use one of the two:

# Option A: MongoDB Atlas (needs internet + DNS working)
PASSWORD=your_mongodb_password

# Option B: Local MongoDB (avoids Atlas DNS issues like ENOTFOUND)
# Uncomment and set; comment out or leave PASSWORD empty if using this.
# MONGODB_URI=mongodb://localhost:27017/petapp

# JWT secret for auth tokens (set in production)
JWT_SECRET=your-secret-key-change-in-production
